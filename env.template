# SignalMuse AI Financial News Analysis Agent
# Environment Variables Template
# 
# Instructions:
# 1. Copy this file to .env: cp env.template .env
# 2. Replace the placeholder values with your actual API keys
# 3. Never commit the .env file to version control

# =============================================================================
# REQUIRED API KEYS
# =============================================================================

# Groq API Key (REQUIRED for AI report generation)
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"

# Finnhub API Key (OPTIONAL - for future stock data integration)
# Get your key from: https://finnhub.io/register
FINNHUB_API_KEY="your_finnhub_api_key_here"

# =============================================================================
# API RATE LIMITING & CONFIGURATION  
# =============================================================================

# API calls per minute limit (adjust based on your plan)
API_CALLS_PER_MINUTE=60

# Groq API Configuration
GROQ_MODEL="llama3-8b-8192"
GROQ_MAX_TOKENS=1000
GROQ_TEMPERATURE=0.7

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# Yahoo Finance RSS scraping settings
YAHOO_RSS_TIMEOUT=10
YAHOO_RSS_MAX_ARTICLES=50

# Sentiment analysis model configuration
SENTIMENT_MODEL="distilbert-base-uncased-finetuned-sst-2-english"
USE_GPU=true

# Output settings
DEFAULT_OUTPUT_DIR="signalmuse/outputs"
DEFAULT_DATA_DIR="signalmuse/data/real"

# Logging configuration
LOG_LEVEL="INFO"
LOG_FILE="signalmuse.log" 